[{n:5001,user:"u_grace",name:"Grace Afolabi",email:"grace.afolabi@mail.example",category:"enquiries",subject:"Moving-in date for my Yaba apartment",status:"in_progress",messages:[["2026-11-05 09:30","u_grace",!1,"Hello, once I make the rent payment, how soon can I move in? I would like to plan for 1 December."],["2026-11-05 11:05","u_mariam",!0,"Good morning Grace. Your lawyer, Nneka Eze, will confirm the move-in date with the landlord once both payments are received. I have flagged your preferred date on your case."]]},{n:5002,name:"Chiamaka Eze",email:"chiamaka.eze@mail.example",phone:"+2348030000101",category:"listings",subject:"Listing a property in Nsukka",status:"open",messages:[["2026-11-05 12:20",null,!1,"Good afternoon. I own a four-bedroom duplex in Nsukka. Do you accept listings outside Enugu city, and what information will your lawyers need from me?"]]},{n:5003,user:"u_samuel",name:"Samuel Okoro",email:"samuel.okoro@mail.example",category:"fraud",subject:"Caller claiming to be from ELVICTORIA",status:"open",messages:[["2026-11-06 15:40","u_samuel",!1,'I received a call from someone who said he was an ELVICTORIA agent and asked me to pay a "booking fee" for the Ikate terrace into a personal account. Is this genuine?']]},{n:5004,name:"Bayo Ogunleye",email:"bayo.ogunleye@mail.example",category:"other",subject:"Corporate relocation enquiry",status:"resolved",messages:[["2026-11-02 09:45",null,!1,"Our company is relocating six staff to Lagos in January. Can your team help us find serviced apartments on the Island and manage the tenancies?"],["2026-11-02 14:00","u_mariam",!0,"Thank you for contacting ELVICTORIA. A member of our team called you this afternoon to discuss your requirements. Please register an account so each enquiry can be assigned to a lawyer."]]},{n:5005,user:"u_femi",name:"Femi Balogun",email:"femi@balogunrealty.example",category:"technical",subject:"Photo upload on mobile",status:"resolved",messages:[["2026-10-20 10:10","u_femi",!1,"Photos taken on my phone were not uploading for a new listing."],["2026-10-20 12:30","u_obinna",!0,"Thanks Femi. Images above 8 MB are not accepted. Please reduce the photo size or use the “Medium” camera setting and try again."],["2026-10-20 13:05","u_femi",!1,"That worked, thank you."]]}]