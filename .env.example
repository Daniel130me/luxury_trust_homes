# ELVICTORIA frontend (Next.js) — environment template.
# Copy to .env.local (or .env) and fill in. Never commit real secrets.

# Base URL of the ELVICTORIA Express API.
# - Empty (default): same-origin requests — /api/* is answered by a reverse
#   proxy in front of both apps (the standard self-hosting setup).
# - Or an absolute origin, e.g. https://api.elvictoria.example, when the API
#   is served from a different domain.
NEXT_PUBLIC_API_BASE_URL=

# SANDBOX-ONLY (NON-STANDARD, dev preview): the preview gateway exposes a
# single port, so API calls carry ?XTransformPort=<backend port> and Caddy
# forwards them to the Express server. Leave empty outside the sandbox.
NEXT_PUBLIC_API_GATEWAY_PORT=3030
