# ELVICTORIA backend — environment template.
# Copy to .env and fill in real values. Never commit the filled-in file.

# Runtime
NODE_ENV=development
PORT=3030

# Neon PostgreSQL
# - DATABASE_URL: pooled connection (pgbouncer) for runtime queries.
# - DATABASE_DIRECT_URL: direct connection for migrations / DDL.
DATABASE_URL=postgresql://USER:PASSWORD@EP-POOLED-HOST/DB?sslmode=require
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@EP-DIRECT-HOST/DB?sslmode=require

# Cloudflare R2 (S3-compatible). DEV credentials — rotate before production.
R2_BUCKET=your-bucket
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# Flutterwave v3. Test keys only until go-live.
FLW_SECRET_KEY=FLWSECK_TEST-xxxx-X
# Public key (optional, client-side inline checkout)
FLW_PUBLIC_KEY=
# Shared secret for the "verif-hash" webhook header — set when registering
# the webhook URL (https://<API_ORIGIN>/api/payments/webhook) in the
# Flutterwave dashboard. Until then the webhook rejects every request.
FLW_WEBHOOK_SECRET=
FLW_ENVIRONMENT=test

# Auth — JWT_SECRET must be at least 16 characters (use `openssl rand -hex 24`).
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=900        # seconds (15 min access token)
REFRESH_TTL_DAYS=30       # refresh session lifetime

# CORS / absolute links (password-reset emails, payment redirect-backs)
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
